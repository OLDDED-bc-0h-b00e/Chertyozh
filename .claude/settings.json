{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/site/**)",
      "Edit(/CLAUDE.md)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .\\check.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File check.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File check.ps1*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)"
    ],
    "ask": [
      "Edit(/brief/assets/**)",
      "Edit(/canvas/**)",
      "Edit(/serve.ps1)",
      "Edit(/.github/**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/check.ps1", "-Hook"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
